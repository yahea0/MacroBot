<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="#1E1E2C"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvActionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Click [x:500, y:1000]"
            android:textColor="#D0BCFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="#381E72"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Main Job"
            android:textColor="#E8DEF8"
            android:textSize="12sp" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvActionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Delay Before: 0ms | Delay After: 1000ms | Speed: 50ms"
        android:textColor="#AAAAB3"
        android:textSize="13sp" />

</LinearLayout>
